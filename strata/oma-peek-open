#!/bin/bash
# Open 3D models in oma-peek viewer windows, detached from the caller. Installed as
# ~/.local/share/oma-peek/oma-peek-open and run by the Strata "Preview in oma-peek" action:
# Strata's job finishes once the viewer has started, not when its window is closed.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${OMA_PEEK_DEBUG:-}" ]; then
    exec gjs "$here/oma-peek-open.js" "$@"
fi
log="${XDG_CACHE_HOME:-$HOME/.cache}/oma-peek/open.log"
mkdir -p "$(dirname "$log")"
setsid -f gjs "$here/oma-peek-open.js" "$@" </dev/null >>"$log" 2>&1
